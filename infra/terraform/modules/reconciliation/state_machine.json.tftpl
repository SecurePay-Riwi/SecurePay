{
  "Comment": "Nightly reconciliation: read the partners' files, match them with Spark, save the differences, tell treasury.",
  "TimeoutSeconds": ${timeout_seconds},
  "StartAt": "ReadStatements",
  "States": {
    "ReadStatements": {
      "Comment": "Input {} (the schedule: yesterday in Bogota) or {\"day\": \"YYYY-MM-DD\"}.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${statement_reader_arn}",
        "Payload.$": "$"
      },
      "ResultSelector": {
        "day.$": "$.Payload.day",
        "records_path.$": "$.Payload.records_path",
        "files_read.$": "$.Payload.files_read",
        "records.$": "$.Payload.records",
        "rejected.$": "$.Payload.rejected"
      },
      "ResultPath": "$.ingest",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException", "States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "ReconciliationFailed" }],
      "Next": "MatchWithSpark"
    },
    "MatchWithSpark": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${match_job_name}",
        "Arguments": {
          "--day.$": "$.ingest.day",
          "--records.$": "$.ingest.records_path",
          "--decisions": "s3://${datalake_bucket}/raw/decisiones",
          "--output.$": "States.Format('s3://${datalake_bucket}/curated/conciliacion/fecha={}', $.ingest.day)"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 120,
          "MaxAttempts": 1,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "ReconciliationFailed" }],
      "Next": "SaveDifferences"
    },
    "SaveDifferences": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${difference_writer_arn}",
        "Payload": {
          "day.$": "$.ingest.day",
          "match_path.$": "States.Format('s3://${datalake_bucket}/curated/conciliacion/fecha={}', $.ingest.day)",
          "files_read.$": "$.ingest.files_read",
          "records.$": "$.ingest.records",
          "rejected.$": "$.ingest.rejected"
        }
      },
      "ResultSelector": {
        "matched.$": "$.Payload.matched",
        "differences.$": "$.Payload.differences",
        "new_differences.$": "$.Payload.new_differences"
      },
      "ResultPath": "$.store",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException", "States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "ReconciliationFailed" }],
      "Next": "ExportAnalytics"
    },
    "ExportAnalytics": {
      "Comment": "HU-66: the current state of the cases and the reconciliation of the window, PostgreSQL -> raw/cases and raw/reconciliation. From here on a failure warns ops-alarms and the reconciliation still ends DONE.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${analytics_export_arn}",
        "Payload": {
          "day.$": "$.ingest.day"
        }
      },
      "ResultSelector": {
        "cases.$": "$.Payload.cases",
        "differences.$": "$.Payload.differences",
        "matched.$": "$.Payload.matched"
      },
      "ResultPath": "$.export",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException", "States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.analytics_error", "Next": "WarnAnalyticsFailed" }],
      "Next": "MeasureKaggle"
    },
    "MeasureKaggle": {
      "Comment": "MAG-312: the Kaggle history (PaySim, Sparkov) replayed with the latest catalog -> raw/metrics/kaggle, which BuildAnalytics adds to q2 and q3. A failure only leaves the Kaggle rows of the last run: the analytics go on.",
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${analytics_export_arn}",
        "Payload": {
          "job": "kaggle_metrics"
        }
      },
      "ResultSelector": {
        "transactions.$": "$.Payload.transactions",
        "rules_version.$": "$.Payload.rules_version"
      },
      "ResultPath": "$.kaggle",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.kaggle_error", "Next": "BuildAnalytics" }],
      "Next": "BuildAnalytics"
    },
    "BuildAnalytics": {
      "Comment": "raw -> curated -> analytics with every builder, then the data quality checks (a failed check fails the job).",
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${analytics_job_name}",
        "Arguments": {
          "--day.$": "$.ingest.day",
          "--raw": "s3://${datalake_bucket}",
          "--output": "s3://${datalake_bucket}"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["Glue.ConcurrentRunsExceededException", "Glue.ThrottlingException"],
          "IntervalSeconds": 120,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.analytics_error", "Next": "WarnAnalyticsFailed" }],
      "Next": "ListViews"
    },
    "ListViews": {
      "Type": "Pass",
      "Result": ${view_queries_json},
      "ResultPath": "$.views",
      "Next": "RefreshViews"
    },
    "RefreshViews": {
      "Comment": "CREATE OR REPLACE VIEW q1..q6 (services/analytics/sql/) in the Power BI workgroup. Scans nothing.",
      "Type": "Map",
      "ItemsPath": "$.views",
      "MaxConcurrency": 2,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "INLINE" },
        "StartAt": "CreateView",
        "States": {
          "CreateView": {
            "Type": "Task",
            "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
            "Parameters": {
              "QueryString.$": "$",
              "WorkGroup": "${athena_workgroup}",
              "QueryExecutionContext": { "Database": "${glue_database}" }
            },
            "Retry": [
              {
                "ErrorEquals": ["Athena.TooManyRequestsException", "Athena.AmazonAthenaException"],
                "IntervalSeconds": 10,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.analytics_error", "Next": "WarnAnalyticsFailed" }],
      "Next": "NotifyTreasury"
    },
    "WarnAnalyticsFailed": {
      "Comment": "The day is reconciled; only the dashboard is late. Tell the team, then treasury as usual.",
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${ops_alarms_topic_arn}",
        "Subject.$": "States.Format('Analytics of {} failed', $.ingest.day)",
        "Message.$": "States.Format('The reconciliation of {} is done, but its analytics failed: {}. Open the execution in Step Functions; run the Glue job ${analytics_job_name} again with --day {} once the cause is fixed.', $.ingest.day, $.analytics_error.Cause, $.ingest.day)"
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "NotifyTreasury" }],
      "Next": "NotifyTreasury"
    },
    "NotifyTreasury": {
      "Comment": "Treasury needs the day's result and the pending differences (assignment, actors). The details are in the cases API.",
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${business_alerts_topic_arn}",
        "Subject.$": "States.Format('Reconciliation of {} done', $.ingest.day)",
        "Message.$": "States.Format('Reconciliation of {} done. Files read: {}. Records: {}. Rejected rows: {}. Matched: {}. Differences of the day: {} (new: {}). Pending differences: GET /reconciliation/differences in the cases API.', $.ingest.day, $.ingest.files_read, $.ingest.records, $.ingest.rejected, $.store.matched, $.store.differences, $.store.new_differences)",
        "MessageAttributes": {
          "audience": {
            "DataType": "String",
            "StringValue": "treasury"
          }
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 2,
          "BackoffRate": 2
        }
      ],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "ResultPath": "$.error", "Next": "ReconciliationFailed" }],
      "End": true
    },
    "ReconciliationFailed": {
      "Type": "Fail",
      "Error": "ReconciliationFailed",
      "CausePath": "$.error.Cause"
    }
  }
}
