meta {
  name: Case inbox (happy)
  type: http
  seq: 2
}

get {
  url: {{cases}}/cases
  body: none
  auth: none
}

script:post-response {
  const items = res.getBody().items || [];
  if (items.length) {
    bru.setVar("caseId", items[0].id);
  }
}

assert {
  res.status: eq 200
}

docs {
  Pending cases by risk, then due time (RN-09).
}
