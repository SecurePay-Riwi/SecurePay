# Conexión a PostgreSQL. Elige una (ver README, paso 6):
# Opción A: PostgreSQL instalado en tu máquina (puerto 5432)
DATABASE_URL=postgresql://pagoseguro:pagoseguro@localhost:5432/pagoseguro
# Opción B: PostgreSQL de Docker Compose (puerto 5433)
# DATABASE_URL=postgresql://pagoseguro:pagoseguro@localhost:5433/pagoseguro

# Seed
SEED=42
SEED_MODE=dev
SEED_RESET=false
SEED_DEFECT_PERCENTAGE=0
SEED_CUENTAS_BLOQUEADAS_PCT=2
SEED_USUARIOS_EN_LISTA_PCT=0.1
SEED_USUARIOS_EN_LISTA_MIN=5
SEED_COMERCIOS_NUEVOS_PCT=10
SEED_COMERCIOS_NUEVOS_DIAS=30
# Lista del proveedor que exporta el seed para el servicio de listas.
# file: solo generated/listas/. s3: además al bucket del proveedor.
SEED_LIST_OUTPUT=file
# SEED_LIST_FILE=generated/listas/lista_restrictiva.jsonl
PROVEEDOR_LISTAS_BUCKET=pagoseguro-proveedor-listas
# PROVEEDOR_LISTAS_KEY=lista_restrictiva.jsonl

# Volúmenes opcionales (si se omiten, se usan los del modo)
# SEED_USERS=100
# SEED_DEVICES_PER_USER=2
# SEED_MERCHANTS=50
# SEED_RESTRICTED_LISTS=20
# SEED_SHARED_DEVICES=4

# Servicio de decisión
VALKEY_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=3600
# Historial por cuenta que leen las reglas (out:{cuenta} e in:{cuenta}).
# Salidas: 24 h (fraccionamiento). Entradas: 60 min (cuenta mula, 30 min).
HISTORY_OUT_HOURS=24
HISTORY_IN_MINUTES=60
# Security events per account (sec:{account}), read by the account
# takeover rule (1-hour window).
HISTORY_SECURITY_MINUTES=60
# RN-01: if the rules take longer than this, the default decision applies
# (APPROVE below the catalog's limit in USD, HOLD from it up).
DECISION_TIMEOUT_MS=120
DECISION_WORKERS=40
# Rule thresholds (velocity, mule, default decision limit...) are not
# variables: they live in the rule catalog (shared/rule_catalog.py).

# Mensajería (SNS + SQS) y Data Lake. En local van a LocalStack; en AWS
# AWS_ENDPOINT_URL no se pone y las credenciales salen del rol.
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-2
# LocalStack acepta cualquier credencial; estas son de mentira a propósito.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_DECISIONES_TOPIC_ARN=arn:aws:sns:us-east-2:000000000000:decisiones
DATALAKE_BUCKET=pagoseguro-datalake
# Publicación desde el motor: hasta 10 eventos por llamada a SNS.
PUBLISH_BATCH_WAIT_MS=500
PUBLISH_BUFFER_SIZE=10000
PUBLISH_RETRIES=3

# Docker Compose (docker compose up -d)
POSTGRES_USER=pagoseguro
POSTGRES_PASSWORD=pagoseguro
POSTGRES_DB=pagoseguro
# Token personal de LocalStack (app.localstack.cloud, plan Hobby gratis).
# Va solo en tu .env, nunca en el repo.
LOCALSTACK_AUTH_TOKEN=

# Generador de transacciones (hace de core)
GEN_MODE=dev
# file: escribe los eventos en generated/ sin mandarlos.
# http: los manda al motor y guarda su respuesta en labels.jsonl.
GEN_OUTPUT=file
GEN_ENGINE_URL=http://localhost:8000
GEN_RATE=50
GEN_FRAUD_PERCENTAGE=5
GEN_DUPLICATE_PERCENTAGE=2
GEN_OUT_OF_ORDER_PERCENTAGE=2
GEN_DECIMAL_DEFECT_PERCENTAGE=1
# GEN_TRANSACTIONS=1000
# GEN_MAX_ACCOUNTS=0
# GEN_OUTPUT_DIR=generated
# GEN_INSTANCE_INDEX=0
# GEN_INSTANCE_COUNT=1

# Extractos de los socios (lee la salida del generador de transacciones)
# file: los deja en generated/extractos/. s3: además en raw/extractos/.
EXT_OUTPUT=file
EXT_MISSING_PCT=2
EXT_EXTRA_PCT=1
EXT_ROUNDING_PCT=3
EXT_RESEND_PCT=10
EXT_BAD_CONTROL_PCT=10
# EXT_INPUT_DIR=generated
# EXT_OUTPUT_DIR=generated/extractos

# Servicio simulado de listas restrictivas (proveedor externo, puerto 8001)
# file: lee SEED_LIST_FILE. s3: lee el bucket del proveedor.
LISTA_SOURCE=file
LISTA_LATENCIA_MIN_MS=50
LISTA_LATENCIA_MAX_MS=3000
LISTA_FALLA_PCT=5
# LISTA_SEMILLA=42

# Descarga de los datasets de Kaggle a S3 (uv run python -m sources.csv_files.kaggle)
# Token personal (kaggle.com/settings/api → "Generate New Token").
# Solo en tu .env, nunca en el repo.
KAGGLE_API_TOKEN=
# Carpeta local donde se descargan los CSV (no va a git).
KAGGLE_DOWNLOAD_DIR=data/kaggle
# true: vuelve a descargar aunque el CSV ya esté en la carpeta.
# KAGGLE_FORCE_DOWNLOAD=false

# ETL de los datasets históricos de Kaggle (opcionales; si se cambian, todos
# los compañeros deben usar los mismos valores)
# HIST_PAYSIM_FILAS=50000
# HIST_PAYSIM_FRAUDE_PCT=3
# HIST_FRAUDTEST_FILAS=20000
# HIST_FRAUDTEST_FRAUDE_PCT=3
# Carpeta de los CSV. Si no se define, se busca en db/datasets/raw y en
# KAGGLE_DOWNLOAD_DIR; los dos CSV deben estar juntos en la misma carpeta.
# HIST_RAW_DIR=db/datasets/raw
