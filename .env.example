# Conexión a PostgreSQL local
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/pagoseguro 

# Seed
SEED=42
SEED_MODE=dev
SEED_RESET=false
SEED_DEFECT_PERCENTAGE=0
SEED_CUENTAS_BLOQUEADAS_PCT=2
SEED_USUARIOS_EN_LISTA_PCT=0.1
SEED_USUARIOS_EN_LISTA_MIN=5
SEED_COMERCIOS_NUEVOS_PCT=10
SEED_COMERCIOS_NUEVOS_DIAS=30

# Volúmenes opcionales (si se omiten, se usan los del modo)
# SEED_USERS=100
# SEED_DEVICES_PER_USER=2
# SEED_MERCHANTS=50
# SEED_RESTRICTED_LISTS=20
# SEED_SHARED_DEVICES=4

# Servicio de decisión
VALKEY_URL=redis://localhost:6379/0
IDEMPOTENCY_TTL_SECONDS=3600
VELOCITY_WINDOW_MINUTES=10
VELOCITY_LIMIT=5

# Generador de transacciones (hace de core)
GEN_MODE=dev
# file: escribe los eventos en generated/ sin mandarlos.
# http: los manda al motor (cuando acepte el formato nuevo).
GEN_OUTPUT=file
GEN_ENGINE_URL=http://localhost:8000
GEN_RATE=50
GEN_FRAUD_PERCENTAGE=5
GEN_DUPLICATE_PERCENTAGE=2
GEN_OUT_OF_ORDER_PERCENTAGE=2
GEN_DECIMAL_DEFECT_PERCENTAGE=1
# GEN_TRANSACTIONS=1000
# GEN_MAX_ACCOUNTS=0
# GEN_OUTPUT_DIR=generated
# GEN_INSTANCE_INDEX=0
# GEN_INSTANCE_COUNT=1
